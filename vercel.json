{
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/(.*?)\\.php", "dest": "/$1.php" },
    { "src": "/adminside/(.*?)\\.php", "dest": "/adminside/$1.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
